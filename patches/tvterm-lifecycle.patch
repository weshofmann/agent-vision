+bool PtyMaster::pollExit() noexcept
+{
+    if (reaped) return true;
+    int value;
+    pid_t result;
+    do { result = waitpid(d.clientPid, &value, WNOHANG); }
+    while (result == -1 && errno == EINTR);
+    if (result == d.clientPid || result == -1)
+    {
+        // ECHILD/other wait errors never justify signalling a possibly reused PID.
+        reaped = true;
+        status = result == d.clientPid ? value : -2;
+    }
+    return reaped;
+}
